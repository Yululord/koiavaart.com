# Copy to .env.local and fill in.

# Hosts allowed to reach the dev server, so the site can be opened on a phone
# on the same network. Comma-separated, no protocol or port.
#
# Find your machine's address with:
#   ipconfig getifaddr en0        # e.g. 192.168.1.42
#   scutil --get LocalHostName    # append .local, e.g. my-laptop.local
#
# Leave unset if you only ever use localhost.
DEV_ORIGINS=
